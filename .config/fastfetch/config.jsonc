{
	"$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
	"logo": {
		"type": "small",
		"padding": {
			"top": 1
		}
	},
	"display": {
		"separator": " "
	},
	"modules": [
		{
			"key": "{#39}╭───────────╮",
			"type": "custom"
		},
		{
			"key": "{#39}│ {#31} user    {#39}│",
			"type": "title",
			"format": "{user-name}"
		},
		{
			"key": "{#39}│ {#32}󰇅 host    {#39}│",
			"type": "title",
			"format": "{host-name}"
		},
		{
			"key": "{#39}│ {#34}󰟾 distro  {#39}│",
			"type": "os",
			"format": "{name} {version-id}"
		},
		{
			"key": "{#39}│ {#33}󰅐 uptime  {#39}│",
			"type": "uptime",
			"format": "{hours} Hrs {minutes} Mins"
		},
		{
			"key": "{#39}│ {#31} term    {#39}│",
			"type": "terminal",
			"format": "Windows Terminal"
		},
		{
			"key": "{#39}│ {#32} shell   {#39}│",
			"type": "shell",
			"format": "Fish {version}"
		},
		{
			"key": "{#39}│ {#34}󰉉 disk    {#39}│",
			"type": "disk",
			"folders": "/",
			"format": "{size-used} ({size-percentage})"
		},
		{
			"key": "{#39}│ {#35} memory  {#39}│",
			"type": "memory",
			"format": "{used} ({percentage})"
		},
		{
			"key": "{#39}│ {#36}󰩟 network {#39}│",
			"type": "localip",
			"format": "{ipv4}"
		},
		{
			"key": "{#39}├───────────┤",
			"type": "custom"
		},
		{
			"key": "{#39}│ {#39} colors  {#39}│ 󰮯 ",
			"type": "colors",
			"symbol": "circle"
		},
		{
			"key": "{#39}╰───────────╯",
			"type": "custom"
		}
	]
}
